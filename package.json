{
  "name": "hanoi-legends-rpg",
  "version": "1.0.0",
  "description": "Cozy open-world roleplay game set in Hanoi — 20 km², Phase 1 vertical slice",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "tsx watch src/server/index.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src scripts --ext .ts,.tsx",
    "tokens": "tsx scripts/check-tokens.ts",
    "contrast": "tsx scripts/check-contrast.ts",
    "schema": "tsx scripts/check-schema.ts",
    "verify:world": "tsx scripts/verify-world.ts",
    "gate": "npm run lint && tsc --noEmit && npm run tokens && npm run contrast && npm run schema && npm run verify:world && npm run test:run",
    "check": "tsc --noEmit && vitest run && npm run verify:world"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "@react-three/fiber": "^8.15.0",
    "@types/three": "^0.160.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "three": "^0.160.0",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.2",
    "vite": "^5.0.7",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
