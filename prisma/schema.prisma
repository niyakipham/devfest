// Prisma schema — hanoi-legends
//
// Rewritten in Phase 1.5 (debt repayment). The previous 815-line schema was
// authored for the abandoned monster-collector prototype: it carried
// CompanionSpecies / Companion / Move / GachaBanner / GachaPull /
// BattlePassSeason / BattlePassProgress and an undefined `CharacterSkill`
// relation, so `prisma validate` could not even parse it.
//
// Scope fence (docs/MASTER_PROMPT_HANOI_60K_v3.md §1.5): gacha, loot boxes and
// pay-to-win are NEVER allowed in this project, so those tables are deleted, not
// migrated. They remain in git history (commit a412d0e) if anyone needs the
// reference.
//
// The live game is PlayerProfile-centric: one save slot holds needs, craft level,
// reputation and pieces; money only ever moves through the double-entry ledger.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================== IDENTITY ==============================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         Role     @default(PLAYER)
  isBanned     Boolean  @default(false)
  banReason    String?
  // NĐ 147/2024 requires full name, date of birth and a Vietnamese phone number
  // at registration. Stored hashed/encrypted at rest, never returned by the API.
  fullName     String?
  dateOfBirth  DateTime?
  phone        String?
  guardianId   String?
  createdAt    DateTime @default(now())
  lastLogin    DateTime?

  profile   PlayerProfile?
  saves     SaveSlot[]
  wallet    Wallet?
  purchases Purchase[]
  posts     PhotoPost[]
  reports   Report[]      @relation("reporter")

  @@index([email])
  @@index([username])
}

enum Role {
  PLAYER
  CREATOR
  SUPPORT
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

// ============================== PLAYER ==============================

model PlayerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String   @db.VarChar(24)
  persona   Persona  @default(STUDENT)
  bio       String?  @db.VarChar(200)
  inCharacter Boolean @default(true)

  // three progression axes (no combat level, ever)
  craftLevel Int @default(1)
  craftXp    Int @default(0)
  pieces     String[] @default([])

  settingsJson Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  crafts     CraftProgress[]
  reputations Reputation[]
  wardrobe   WardrobeItem[]
  housing    Housing?
  quests     QuestInstance[]
  photos     PhotoPost[]
  inventory  InventoryItem[]

  @@index([persona])
}

/// One row per profession a player has practiced (blueprint §2.5 RP-04).
model CraftProgress {
  id        String  @id @default(cuid())
  profileId String
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  persona   Persona
  level     Int     @default(1)
  xp        Int     @default(0)

  @@unique([profileId, persona])
  @@index([profileId])
}

enum Persona {
  STUDENT
  SILVERSMITH
  PHO_VENDOR
  CYCLO_DRIVER
  PHOTOGRAPHER
  FOLK_SINGER
}

/// Five factions, −100…+100, decays 1/day without interaction (§2.6 NPC-07).
model Reputation {
  id        String  @id @default(cuid())
  profileId String
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  faction   Faction
  value     Int     @default(0)
  updatedAt DateTime @updatedAt

  @@unique([profileId, faction])
}

enum Faction {
  RESIDENT
  MERCHANT
  ARTISAN
  YOUTH
  HERITAGE
}

model WardrobeItem {
  id          String  @id @default(cuid())
  profileId   String
  profile     PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  catalogId   String
  slot        ClothingSlot
  dye         String?
  isEquipped  Boolean @default(false)
  acquiredAt  DateTime @default(now())

  @@unique([profileId, catalogId])
  @@index([profileId, slot])
}

enum ClothingSlot {
  TOP
  BOTTOM
  SHOES
  HAT
  BAG
  ACCESSORY
}

model Housing {
  id          String  @id @default(cuid())
  profileId   String  @unique
  profile     PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  district    String
  rentPerDay  Int
  layoutJson  Json
  comfort     Int     @default(0)
}

/// items the player owns; the catalog itself is static content, not a table
model Item {
  id        String   @id
  name      String
  nameEn    String?
  kind      ItemKind
  icon      String
  stackable Boolean  @default(true)

  holdings InventoryItem[]
}

enum ItemKind {
  FOOD
  MATERIAL
  TOOL
  COSMETIC
  TICKET
}

model InventoryItem {
  id        String  @id @default(cuid())
  profileId String
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item    @relation(fields: [itemId], references: [id])
  quantity  Int     @default(1)
  slot      Int?

  @@unique([profileId, itemId])
  @@index([profileId])
}

// ============================== WORLD ==============================

model WorldTile {
  id        String   @id // "t_07_04"
  x         Int
  z         Int
  version   Int      @default(1)
  poiCount  Int      @default(0)
  updatedAt DateTime @updatedAt

  pois Poi[]

  @@unique([x, z])
  @@index([version])
}

model Poi {
  id           String  @id
  tileId       String
  tile         WorldTile @relation(fields: [tileId], references: [id])
  type         PoiType
  name         String
  nameEn       String?
  x            Float
  z            Float
  radius       Float   @default(2)
  district     String
  street       String?
  craft        String?
  action       String?
  hoursJson    Json? // [[openMinute, closeMinute]]
  payloadJson  Json?
  isActive     Boolean @default(true)

  @@index([tileId, type])
  @@index([district])
}

enum PoiType {
  SHOP
  FOOD
  LANDMARK
  QUEST_GIVER
  PHOTO_SPOT
  BENCH
  SHRINE
  WORKSHOP
  TRANSPORT
}

// ============================== NARRATIVE ==============================

model Npc {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  nameEn       String?
  district     String
  street       String?
  scheduleJson Json // timetable 24h × 7 × season
  memoryJson   Json? // last 12 player events
  faction      Faction?
  isActive     Boolean  @default(true)
}

model QuestDef {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  titleEn     String?
  type        QuestType
  graphJson   Json // objectives + dialogue refs
  rewardsJson Json // { dong, xp, piece?, reputation? }
  isPublished Boolean  @default(false)

  instances QuestInstance[]
}

enum QuestType {
  MAIN
  SIDE
  DAILY
  WEEKLY
  FESTIVAL
}

model QuestInstance {
  id        String     @id @default(cuid())
  profileId String
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  questKey  String
  quest     QuestDef  @relation(fields: [questKey], references: [key])
  state     QuestState @default(AVAILABLE)
  progressJson Json
  startedAt DateTime?
  claimedAt DateTime?

  @@unique([profileId, questKey])
  @@index([profileId, state])
}

enum QuestState {
  LOCKED
  AVAILABLE
  ACTIVE
  COMPLETE
  CLAIMED
  FAILED
}

// ============================== SAVE ==============================

model SaveSlot {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot      Int
  version   Int    @default(1)
  payload   Json // SaveGameV1, validated by zod before it is written
  updatedAt DateTime @updatedAt

  @@unique([userId, slot])
  @@index([userId])
}

// ============================== ECONOMY ==============================

model Wallet {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dong      BigInt @default(0)
  hoaSen    Int    @default(0)

  entries LedgerEntry[]
}

/// Double-entry: every transaction writes two lines that sum to zero and is
/// protected by a unique idempotency key. Rows are never updated, only reversed.
model LedgerEntry {
  id             String   @id @default(cuid())
  walletId       String
  wallet         Wallet   @relation(fields: [walletId], references: [id])
  transactionId  String
  account        String
  deltaDong      BigInt   @default(0)
  deltaHoaSen    Int      @default(0)
  reason         String
  refType        String?
  refId          String?
  idempotencyKey String   @unique
  balanceAfter   Json?
  createdAt      DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([transactionId])
}

model Purchase {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku        String
  amountVnd  Int
  currency   String        @default("VND")
  provider   PaymentProvider
  status     PaymentStatus @default(PENDING)
  receiptId  String?       @unique // provider transaction id, unique => no replay
  vatInvoice String?
  createdAt  DateTime      @default(now())

  @@index([userId, createdAt])
}

enum PaymentProvider {
  VNPAY
  MOMO
  ZALOPAY
  STORE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ============================== SOCIAL ==============================

model PhotoPost {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId    String
  profile      PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  url          String
  caption      String?    @db.VarChar(140)
  visibility   Visibility @default(FRIENDS)
  likeCount    Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([createdAt])
  @@index([profileId])
}

enum Visibility {
  PRIVATE
  FRIENDS
  PUBLIC
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation("reporter", fields: [reporterId], references: [id])
  targetType String // photo | chat | profile
  targetId   String
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  @@index([status, createdAt])
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

// ============================== OPS ==============================

/// Append-only. Every admin action lands here.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  target    String?
  metaJson  Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  rollout   Int      @default(0) // 0–100 % of players
  updatedAt DateTime @updatedAt
}

model DailyStats {
  date        DateTime @id @db.Date
  dau         Int      @default(0)
  sessions    Int      @default(0)
  dongMinted  BigInt   @default(0)
  dongBurned  BigInt   @default(0)
  conversion  Float    @default(0)
}
