// Prisma Schema - Hanoi Legends RPG Database
// Full database design for 60,000 LoC project

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ AUTH & USER ============
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String
  role          UserRole  @default(PLAYER)
  isBanned      Boolean   @default(false)
  banReason     String?
  createdAt     DateTime  @default(now())
  lastLogin     DateTime?
  
  character     Character?
  guild         GuildMember[]
  friends       Friend[] @relation("userFriends")
  friendsOf     Friend[] @relation("friendOf")
  marketplaceListings MarketplaceListing[]
  battlePass    BattlePassProgress?
  gachaHistory  GachaPull[]
  
  @@index([email])
  @@index([username])
}

enum UserRole {
  PLAYER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

// ============ CHARACTER ============
model Character {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name            String
  level           Int       @default(1)
  xp              Int       @default(0)
  xpToNextLevel   Int       @default(100)
  
  // Stats
  health          Int       @default(100)
  maxHealth       Int       @default(100)
  energy          Int       @default(100)
  maxEnergy       Int       @default(100)
  
  // Position
  zoneId          String    @default("zone_pho_co")
  positionX       Float     @default(0)
  positionY       Float     @default(0)
  positionZ       Float     @default(0)
  
  // Avatar (JSON)
  avatarJson      Json
  
  // Base stats
  strength        Int       @default(5)
  agility         Int       @default(5)
  intelligence    Int       @default(5)
  charisma        Int       @default(5)
  luck            Int       @default(5)
  
  // Currency
  currency        Int       @default(500)   // Xu Hà Thành
  premiumCurrency Int       @default(50)    // Ngọc Rồng
  
  // Title & achievements
  title           String    @default("Novice Explorer")
  achievementIds  String[]  @default([])
  
  // Streak
  loginStreak     Int       @default(0)
  lastLoginDate   DateTime?
  
  createdAt       DateTime  @default(now())
  lastPlayed      DateTime  @default(now())
  
  // Relations
  companions      Companion[]
  inventory       InventoryItem[]
  activeQuests    QuestProgress[]
  completedQuests CompletedQuest[]
  factionReps     FactionReputation[]
  skills          CharacterSkill[]
  battlePass      BattlePassProgress?
  
  @@index([userId])
  @@index([zoneId])
  @@index([level])
}

// ============ COMPANIONS ============
model CompanionSpecies {
  id              String    @id
  name            String
  element         Element
  rarity          Rarity
  baseHp          Int
  baseAttack      Int
  baseDefense     Int
  baseSpeed       Int
  baseSpAttack    Int
  baseSpDefense   Int
  
  evolutionChain  String[]  // Species IDs in order
  learnableMoves  String[]  // Move IDs
  
  description     String
  lore            String
  habitat         String
  captureRate     Float     @default(0.5)
  
  companions      Companion[]
  
  @@index([element])
  @@index([rarity])
}

enum Element {
  KIM
  MOC
  THUY
  HOA
  THO
}

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}

model Companion {
  id              String    @id @default(cuid())
  characterId     String
  character       Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  
  speciesId       String
  species         CompanionSpecies @relation(fields: [speciesId], references: [id])
  
  nickname        String
  level           Int       @default(1)
  xp              Int       @default(0)
  bondLevel       Int       @default(0)  // 0-100
  
  evolutionStage  Int       @default(0)
  
  // Current stats (modified by training)
  currentHp       Int
  currentAttack   Int
  currentDefense  Int
  currentSpeed    Int
  currentSpAttack Int
  currentSpDefense Int
  
  // Moves (JSON array of move IDs + PP)
  movesJson       Json
  
  isShiny         Boolean   @default(false)
  isFavorite      Boolean   @default(false)
  
  caughtAt        DateTime  @default(now())
  caughtLocation  String
  
  @@index([characterId])
  @@index([speciesId])
  @@index([level])
}

// ============ MOVES ============
model Move {
  id          String  @id
  name        String
  element     Element
  power       Int
  accuracy    Int
  pp          Int
  maxPp       Int
  description String
  effectsJson Json?   // Move effects
  
  companions  Companion[]
}

// ============ INVENTORY ============
model Item {
  id          String  @id
  name        String
  description String
  type        ItemType
  rarity      Rarity  @default(COMMON)
  icon        String
  stackable   Boolean @default(true)
  maxStack    Int     @default(99)
  sellPrice   Int     @default(0)
  buyPrice    Int     @default(0)
  
  inventory   InventoryItem[]
  marketplace MarketplaceListing[]
  crafting    CraftingRecipe[] @relation("product")
  craftingMat CraftingMaterial[]
}

enum ItemType {
  WEAPON
  ARMOR
  CONSUMABLE
  QUEST_ITEM
  COLLECTIBLE
  MATERIAL
  COMPANION_ITEM
  COSMETIC
}

model InventoryItem {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  
  slot        Int
  quantity    Int       @default(1)
  
  @@unique([characterId, slot])
  @@index([characterId])
}

// ============ QUESTS ============
model Quest {
  id              String    @id
  type            QuestType
  chapter         Int?
  title           String
  description     String
  detailedDesc    String
  
  zoneId          String
  giverNpcId      String
  
  // Prerequisites (JSON)
  prerequisitesJson Json
  
  // Objectives (JSON)
  objectivesJson    Json
  
  // Rewards
  rewardXp          Int
  rewardCurrency    Int
  rewardItemsJson   Json  // [{itemId, quantity}]
  rewardCompanionId String?
  rewardRepJson     Json? // {factionId, amount}
  
  factionId         String?
  reputationRequired Int   @default(0)
  levelRequired     Int   @default(1)
  
  repeatable        Boolean @default(false)
  resetInterval     String? // "daily", "weekly"
  
  // Dialogue (JSON)
  dialogueJson      Json
  
  progress      QuestProgress[]
  completed     CompletedQuest[]
  
  @@index([type])
  @@index([zoneId])
  @@index([levelRequired])
}

enum QuestType {
  MAIN
  SIDE
  DAILY
  WEEKLY
  FACTION
  DYNAMIC
}

model QuestProgress {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  
  questId     String
  quest       Quest     @relation(fields: [questId], references: [id])
  
  status      QuestStatus @default(ACCEPTED)
  objectivesJson Json    // Current progress per objective
  
  startedAt   DateTime  @default(now())
  
  @@unique([characterId, questId])
  @@index([characterId])
}

enum QuestStatus {
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  FAILED
}

model CompletedQuest {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  
  questId     String
  quest       Quest     @relation(fields: [questId], references: [id])
  
  completedAt DateTime  @default(now())
  
  @@unique([characterId, questId])
}

// ============ FACTIONS ============
model Faction {
  id          String  @id
  name        String
  description String
  icon        String
  color       String
  
  reputation  FactionReputation[]
  quests      Quest[]
  
  // Reputation thresholds
  thresholds  Json    // {name: string, repRequired: int, title: string}[]
}

model FactionReputation {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  
  factionId   String
  faction     Faction   @relation(fields: [factionId], references: [id])
  
  reputation  Int       @default(0)
  title       String    @default("Stranger")
  
  @@unique([characterId, factionId])
}

// ============ SOCIAL ============
model Guild {
  id          String    @id @default(cuid())
  name        String    @unique
  description String    @default("")
  leaderId    String
  level       Int       @default(1)
  xp          Int       @default(0)
  maxMembers  Int       @default(20)
  
  createdAt   DateTime  @default(now())
  
  members     GuildMember[]
  chatMessages GuildChatMessage[]
  
  @@index([leaderId])
}

model GuildMember {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  guildId     String
  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  
  role        GuildRole @default(MEMBER)
  joinedAt    DateTime  @default(now())
  contribution Int      @default(0)
  
  @@unique([userId, guildId])
}

enum GuildRole {
  LEADER
  OFFICER
  MEMBER
}

model Friend {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("userFriends", fields: [userId], references: [id], onDelete: Cascade)
  
  friendId    String
  friend      User      @relation("friendOf", fields: [friendId], references: [id], onDelete: Cascade)
  
  status      FriendStatus @default(PENDING)
  createdAt   DateTime  @default(now())
  
  @@unique([userId, friendId])
}

enum FriendStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model ChatMessage {
  id          String    @id @default(cuid())
  channel     ChatChannel
  senderId    String
  content     String
  
  guildId     String?
  zoneId      String?
  
  createdAt   DateTime  @default(now())
  
  @@index([channel])
  @@index([createdAt])
}

enum ChatChannel {
  GLOBAL
  ZONE
  PARTY
  GUILD
  PRIVATE
}

model GuildChatMessage {
  id          String    @id @default(cuid())
  guildId     String
  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  
  senderId    String
  content     String
  createdAt   DateTime  @default(now())
  
  @@index([guildId])
}

// ============ MARKETPLACE ============
model MarketplaceListing {
  id          String    @id @default(cuid())
  sellerId    String
  seller      User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  
  quantity    Int
  price       Int
  status      ListingStatus @default(ACTIVE)
  
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  
  @@index([sellerId])
  @@index([itemId])
  @@index([status])
}

enum ListingStatus {
  ACTIVE
  SOLD
  EXPIRED
  CANCELLED
}

// ============ CRAFTING ============
model CraftingRecipe {
  id          String  @id
  name        String
  productId   String
  product     Item    @relation("product", fields: [productId], references: [id])
  
  materials   CraftingMaterial[]
  craftTime   Int     @default(0) // seconds
  levelReq    Int     @default(1)
  
  @@index([productId])
}

model CraftingMaterial {
  id          String  @id @default(cuid())
  recipeId    String
  recipe      CraftingRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  
  itemId      String
  item        Item    @relation(fields: [itemId], references: [id])
  
  quantity    Int
  
  @@unique([recipeId, itemId])
}

// ============ BATTLE PASS ============
model BattlePassSeason {
  id          String    @id
  name        String
  theme       String
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean   @default(false)
  
  // Rewards per tier (JSON)
  freeRewardsJson   Json
  premiumRewardsJson Json
  
  price             Int @default(299000) // VND
  
  progresses        BattlePassProgress[]
  
  @@index([isActive])
}

model BattlePassProgress {
  id          String    @id @default(cuid())
  characterId String    @unique
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  
  seasonId    String
  season      BattlePassSeason @relation(fields: [seasonId], references: [id])
  
  level       Int       @default(0)
  xp          Int       @default(0)
  isPremium   Boolean   @default(false)
  claimedTiers Int[]    @default([])
  
  @@index([seasonId])
}

// ============ GACHA ============
model GachaBanner {
  id          String    @id
  name        String
  type        GachaType
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean   @default(false)
  
  // Featured species with rates
  ratesJson   Json  // [{speciesId, rate, rarity}]
  
  pulls       GachaPull[]
  
  @@index([isActive])
}

enum GachaType {
  STANDARD
  LIMITED
  EVENT
}

model GachaPull {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  bannerId    String
  banner      GachaBanner @relation(fields: [bannerId], references: [id])
  
  resultSpeciesId String
  resultRarity    Rarity
  
  pityCount   Int       @default(0)
  isGuaranteed Boolean @default(false)
  
  pulledAt    DateTime  @default(now())
  
  @@index([userId])
  @@index([bannerId])
}

// ============ SEASONAL EVENTS ============
model SeasonalEvent {
  id          String    @id
  name        String
  description String
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean   @default(false)
  
  configJson  Json  // Event-specific config
  
  @@index([isActive])
}

// ============ ANALYTICS ============
model AnalyticsEvent {
  id          String    @id @default(cuid())
  userId      String
  eventType   String
  eventData   Json
  createdAt   DateTime  @default(now())
  
  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}

model DailyStats {
  date        DateTime  @id @default(now())
  dau         Int       @default(0)
  mau         Int       @default(0)
  newUsers    Int       @default(0)
  revenue     Float     @default(0)
  sessions    Int       @default(0)
  avgSession  Float     @default(0) // minutes
}
